<Project>
  <!-- Shared build settings for the whole transports/csharp tree. Nullable + warnings-as-errors
       are the C# analogue of the repo's "clippy must be clean" posture: nullable gaps and unused
       usings become build failures rather than silent debt. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
