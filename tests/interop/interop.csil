;; ============================================================
;; CSIL cross-language interop spec.
;;
;; The single authoritative spec for the N-language x N-language
;; interop test suite. Generated once per target language; each
;; language builds a harness that runs as client or server and the
;; orchestrator (`cargo run -p xtask interop`) exercises every type,
;; constraint, and transport (CSIL-RPC, CSIL-Events, CSIL-Datagrams)
;; so the wire standard is proven byte-identical across languages.
;;
;; Conventions interop depends on:
;;   - every operation payload is a NAMED top-level record, so each
;;     generated typed client emits a real method for it;
;;   - field names are snake_case; operation names are kebab-case;
;;   - the RPC service id is the lowercased service base name and the
;;     op id is the PascalCase of the kebab op (e.g. echo-scalars ->
;;     "EchoScalars"); all generators agree on this.
;;
;; This file GROWS as generator codec gaps are closed. Constructs not
;; yet byte-clean across every language live in the DEFERRED block at
;; the bottom and are tracked in the codec gap inventory; each is moved
;; up into the live spec as its matrix cells go green.
;; ============================================================

;; ---- named enums (literal type-choice: bare-literal wire) ----
Color = "red" / "green" / "blue"
;; int-literal enum
Priority = 1 / 2 / 3

;; ---- named union (tagged sum [variant_index, value] on the wire) ----
IdOrName = uint / text

;; ---- full scalar coverage (codec-clean across rust/go/python) ----
Scalars = {
  i: int,
  u: uint,
  n: nint,
  f: float64,
  t: text,
  raw: bytes,
  flag: bool,
  when: timestamp,
  amount: decimal,
}

;; ---- constraints (drives failure cases via validation) ----
Constrained = {
  code: text .size (10..20) .regex "^PRD-[A-Z0-9]+$",
  qty: uint .ge 1 .le 1000,
  rate: decimal .ge "0.0" .le "1.0" .default "0.0",
  @min-length(8) @max-length(128)
  password: text,
  @min-items(1) @max-items(5)
  tags: [* text],
}

;; ---- collections / containers ----
Collections = {
  names: [* text],
  at_least_one: [+ int],
  bounded: [1*5 int],
  exact3: [3 int],
  scores: {text => int},
  color: Color,
  ;; enum-typed field carrying a `.default` — exercises enum default rendering
  ;; (regression: the Kotlin generator emitted a raw String default here, which
  ;; does not typecheck against the enum-typed property).
  tone: Color .default "green",
  prio: Priority,
  who: IdOrName,
  pair: [text, int],
  triple: [text, ?int, ?bool],
  extra: {* text => any},
}

;; ---- nesting + optional field ----
Nested = {
  inner: Scalars,
  maybe?: Constrained,
  many: [* Scalars],
}

EchoNestedResult = { ok: bool, echo: Nested }

;; ---- error arm for the typed error-variant operation. The transport convention
;; is that a declared error arm is named `ServiceError`; the carrier maps a
;; status-0 reply whose variant is `ServiceError` to the language's error path.
ServiceError = { code: int, message: text }

;; ---- event payload ----
Tick = { seq: uint }

@wire-id(1)
service Interop {
  ;; CSIL-RPC, success-only baseline
  @wire-id(0)
  echo-scalars: Scalars -> Scalars,
  @wire-id(1)
  echo-collections: Collections -> Collections,
  @wire-id(2)
  echo-nested: Nested -> EchoNestedResult,
  ;; CSIL-RPC with a typed error arm: the server validates and returns the
  ;; ServiceError arm on invalid input (the failure-case path).
  @wire-id(3)
  validate-constrained: Constrained -> Constrained / ServiceError,
  ;; CSIL-Events server push
  @wire-id(4)
  on-tick: <- Tick,
  ;; bidirectional (client sends, server echoes via the channel router)
  @wire-id(5)
  duplex: Scalars <-> Scalars,
}

