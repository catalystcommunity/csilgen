#!/usr/bin/env bash
# Launch the Elixir harness: run <server|client> <rpc|events|datagrams> <port>.
set -euo pipefail

# shellcheck disable=SC1091
source "$HOME/.local/csilgen-tools/env.sh" 2>/dev/null || true

HERE="$(cd "$(dirname "$0")" && pwd)"
TRANSPORT="$HERE/../../../../transports/elixir"

exec elixir \
  -pa "$HERE/gen/_build/dev/lib/interop_api/ebin" \
  -pa "$TRANSPORT/_build/dev/lib/csilgen_transport/ebin" \
  "$HERE/main.exs" "$@"
