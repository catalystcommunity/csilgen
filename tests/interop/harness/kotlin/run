#!/usr/bin/env bash
# Launch the Kotlin harness: run <server|client> <rpc|events|datagrams> <port>.
set -euo pipefail

# shellcheck disable=SC1091
source "$HOME/.local/csilgen-tools/env.sh" 2>/dev/null || true

HERE="$(cd "$(dirname "$0")" && pwd)"

exec "$HERE/build/install/csil-interop-kotlin/bin/csil-interop-kotlin" "$@"
