#!/usr/bin/env bash
# Launch the OCaml harness: run <server|client> <rpc|events|datagrams> <socket>.
set -euo pipefail

# shellcheck disable=SC1091
source "${CATALYST_TOOLS:-$HOME/.local/catalyst-tools}/env.sh" 2>/dev/null || true

HERE="$(cd "$(dirname "$0")" && pwd)"
exec "$HERE/_build/default/main.exe" "$@"
