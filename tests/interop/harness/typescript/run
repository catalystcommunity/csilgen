#!/usr/bin/env bash
# Launch the TypeScript harness: run <server|client> <rpc|events|datagrams> <port>.
# Runs main.ts directly under Node's native type stripping.
set -euo pipefail

# shellcheck disable=SC1091
source "${CATALYST_TOOLS:-$HOME/.local/catalyst-tools}/env.sh" 2>/dev/null || true
export PATH="$HOME/.local/opt/node/bin:$PATH"

HERE="$(cd "$(dirname "$0")" && pwd)"
exec node "$HERE/main.ts" "$@"
