#!/usr/bin/env bash
# Launch the C# harness: run <server|client> <rpc|events|datagrams> <port>.
set -euo pipefail

# shellcheck disable=SC1091
source "$HOME/.local/csilgen-tools/env.sh" 2>/dev/null || true

HERE="$(cd "$(dirname "$0")" && pwd)"
exec dotnet "$HERE/bin/Release/net8.0/csil-interop.dll" "$@"
