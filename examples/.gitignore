# Generated files and build artifacts
*.wasm
generated/
output/
/tmp/
build/
dist/
target/

# Language-specific generated files
*.rs
*.py
*.ts
*.js
*.json
*.d.ts
__pycache__/
*.pyc
*.pyo
node_modules/
package-lock.json
yarn.lock

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local configuration
.env
.env.local
config.local.*

# Test outputs
test-output/
snapshots/

# custom-generator is a real, checked-in generator crate (see its README), not
# generated output — the broad *.rs rule above is meant for sample output this
# directory's examples emit, not for a generator's own source.
!custom-generator/src/**